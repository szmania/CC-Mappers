<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <xs:complexType name="EnvironmentType">
    <xs:attribute name="key" type="xs:string" use="required" />
  </xs:complexType>

  <xs:complexType name="WeatherType">
    <xs:sequence>
      <xs:element name="Environment" type="EnvironmentType" minOccurs="1" maxOccurs="unbounded" />
    </xs:sequence>
    <xs:attribute name="ck3_type" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:enumeration value="fall" />
          <xs:enumeration value="winter" />
          <xs:enumeration value="spring" />
          <xs:enumeration value="summer" />
          <xs:enumeration value="mild_winter" />
          <xs:enumeration value="normal_winter" />
          <xs:enumeration value="harsh_winter" />
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="DayNightType">
    <xs:sequence>
      <xs:element name="WeatherType" type="WeatherType" minOccurs="0" maxOccurs="unbounded" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="LandSeaType">
    <xs:sequence>
      <xs:element name="Day" type="DayNightType" minOccurs="0" maxOccurs="1" />
      <xs:element name="Night" type="DayNightType" minOccurs="0" maxOccurs="1" />
    </xs:sequence>
  </xs:complexType>

  <xs:element name="Weather">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Land" type="LandSeaType" minOccurs="0" maxOccurs="1" />
        <xs:element name="Sea" type="LandSeaType" minOccurs="0" maxOccurs="1" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>
